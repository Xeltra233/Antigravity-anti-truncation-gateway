# ==============================================================================
# Antigravity Anti-Truncation Gateway Configuration Example
# ==============================================================================

# [必需] 上游服务基址（只写根链接即可，网关会自动补齐 /v1 路径）
# 例如: https://api.openai.com 或 https://your-proxy-domain.com
UPSTREAM_BASE_URL=https://api.openai.com

# [必需] 上游 API 认证 Bearer Key（当 UPSTREAM_AUTH_MODE 为 bearer 时）
UPSTREAM_API_KEY=sk-your-upstream-api-key-here

# 上游认证模式：bearer 或 none（默认: bearer）
UPSTREAM_AUTH_MODE=bearer

# 上游单次请求超时时间（毫秒，默认: 120000 即 2分钟）
UPSTREAM_TIMEOUT_MS=120000

# 上游连接池配置
UPSTREAM_MAX_IDLE_CONNS=2048
UPSTREAM_MAX_IDLE_CONNS_PER_HOST=512
UPSTREAM_MAX_CONNS_PER_HOST=512

# [必需] 网关管理接口鉴权 Key（用于 /admin/keys 创建、列表、吊销下游 Key）
ADMIN_API_KEY=admin-secret-management-key-change-me

# [必需] 下游 Key HMAC-SHA256 签名密钥（至少16字符，不可泄露）
KEY_HMAC_SECRET=your-random-hmac-secret-at-least-16-bytes

# 动态下游 Key 存储 SQLite 数据库路径（默认: ./data/keys.sqlite）
KEY_DB_PATH=./data/keys.sqlite

# 静态下游分发 Key（JSON 数组，纯环境变量部署时使用）
DOWNSTREAM_KEYS_JSON=[{"id":"default-client","key":"sk-agw-default-static-key-12345","name":"Default Client"}]

# 网关监听地址与端口
HOST=0.0.0.0
PORT=8080

# 控制提示词角色：system 或 developer（默认: system）
CONTROL_MESSAGE_ROLE=system

# 控制提示词注入位置：tail (推荐，末尾强生效), head, system_tail（默认: tail）
CONTROL_MESSAGE_POSITION=tail

# 合成工具前缀（仅用于生成随机工具名，默认: agw_emit_）
SYNTHETIC_TOOL_PREFIX=agw_emit_

# 是否发送严格 schema（默认: false）
SYNTHETIC_TOOL_STRICT=false

# 包装模式：prefer（默认注入合成协议），required（强制要求合成协议），off（紧急透明透传回滚）
WRAPPER_MODE=prefer

# 格式恢复策略：repair（默认本地确定性修复），repair_then_retry（修复失败后安全单次重试），fail（直接报错）
RECOVERY_POLICY=repair

# 上游空回（完全没有任何输出）时自动重试次数（默认: 3）
UPSTREAM_EMPTY_RETRIES=3

# 高并发与流式缓冲配置
MAX_REQUEST_BYTES=16777216
MAX_RESPONSE_BYTES=16777216
MAX_CONCURRENT_REQUESTS=1024
MAX_CONCURRENT_REQUESTS_PER_KEY=64
REQUEST_QUEUE_TIMEOUT_MS=50
STREAM_SIDE_BUFFER_BYTES=65536
STREAM_REPAIR_BUFFER_BYTES=1048576
STREAM_FLUSH_INTERVAL_MS=0

# 优雅停机与模型缓存
SHUTDOWN_TIMEOUT_MS=30000
MODELS_CACHE_TTL_MS=30000
LOG_LEVEL=info
TRUST_PROXY=false
